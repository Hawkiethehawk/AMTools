{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amtools.local/contracts/collection-manifest.schema.json",
  "title": "AMTools CollectionManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "source",
    "status",
    "requestedWeeks",
    "categories",
    "topDepth",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "batchId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "source": { "type": "string", "enum": ["manual", "scheduled"] },
    "status": { "type": "string", "enum": ["requested", "running", "failed", "synced"] },
    "requestedWeeks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "topDepth": { "type": "integer", "enum": [100, 1000] },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runDir", "snapshot", "workbook"],
      "properties": {
        "runDir": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "minLength": 1 },
        "workbook": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sheetNames"],
          "properties": {
            "status": { "type": "string", "enum": ["pending", "synced", "failed"] },
            "sheetNames": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "revision": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
